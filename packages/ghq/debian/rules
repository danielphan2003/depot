#!/usr/bin/make -f
# As ../rpm/ghq.spec. Go 1.26 comes from trixie-backports (build only; the
# binary is static). Modules come from proxy.golang.org, pinned by upstream's
# go.sum.
include /usr/share/dpkg/pkg-info.mk

export PATH := /usr/lib/go-1.26/bin:$(PATH)
export GOTOOLCHAIN = local
export GOPATH = $(CURDIR)/../.gopath
export GOCACHE = $(CURDIR)/../.gocache
export GOFLAGS = -mod=readonly -modcacherw -trimpath
export CGO_ENABLED = 0

%:
	dh $@

override_dh_auto_configure:
	go mod download

override_dh_auto_build:
	go build -ldflags "-s -w -X main.revision=v$(DEB_VERSION_UPSTREAM)" -o ghq .

override_dh_auto_test:

override_dh_auto_install:
	install -Dm755 ghq -t debian/ghq/usr/bin

override_dh_auto_clean:
	rm -rf ghq ../.gopath ../.gocache

override_dh_dwz:
override_dh_strip:
