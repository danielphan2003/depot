# Maintainer: depot <https://github.com/danielphan2003/depot>
# Reviewed from the AUR PKGBUILD `flyctl` (aur.git commit a21cf43, audited
# 2026-11-03); see ../AUDIT.md. Builds the way upstream's .goreleaser.yml
# does: `go generate ./...` (genqlient and mockgen, both pinned in go.mod),
# then a static `production` build with the version stamped in. Changes from
# the AUR: sha256 pin, GOTOOLCHAIN=local, upstream's ldflags and tag, no
# `make test` (its tests reach Fly's API), and a two-line `fly` wrapper
# instead of the symlink, since depot packages carry no links.
pkgname=flyctl
pkgver=0.5.6
pkgrel=1
pkgdesc='Command-line client for Fly.io'
arch=('x86_64')
url='https://github.com/superfly/flyctl'
license=('Apache-2.0')
makedepends=('go')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('ee202cd6709d8de16051a295c6671a82f3427b3f2fa97443e22f1af307c6a314')

prepare() {
  cd "$pkgname-$pkgver"
  export GOFLAGS='-mod=readonly -modcacherw' GOTOOLCHAIN=local
  go mod download
  go generate ./...
}

build() {
  cd "$pkgname-$pkgver"
  export GOFLAGS='-mod=readonly -modcacherw -trimpath' GOTOOLCHAIN=local
  local bi=github.com/superfly/flyctl/internal/buildinfo
  CGO_ENABLED=0 go build -tags production -o bin/flyctl -ldflags "-s -w \
    -X $bi.buildDate=$(date -u -d "@${SOURCE_DATE_EPOCH:-0}" +%Y-%m-%dT%H:%M:%SZ) \
    -X $bi.buildVersion=$pkgver -X $bi.commit=v$pkgver" .
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 bin/flyctl -t "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec /usr/bin/flyctl "$@"\n' >bin/fly
  install -Dm755 bin/fly -t "$pkgdir/usr/bin"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
