#!/usr/bin/make -f
# cargo build --locked with Debian's Rust: crates come from crates.io, pinned
# by upstream's Cargo.lock. The tree-sitter parsers are vendored C sources in
# the tarball, compiled by build.rs with Debian's hardening flags.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/buildflags.mk
export CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
export CARGO_HOME = $(CURDIR)/debian/.cargo
export RUSTFLAGS = -C link-args=-Wl,-z,relro,-z,now

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	cargo build --locked --release

override_dh_auto_test:

override_dh_auto_install:
	install -Dm755 target/release/difft -t debian/difftastic/usr/bin

override_dh_auto_clean:
	rm -rf target debian/.cargo
