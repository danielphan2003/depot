#!/usr/bin/make -f
# As ../arch/PKGBUILD: `go generate ./cmd/...`, then a static build with the
# `release` tag. Go 1.26 comes from trixie-backports (build only; the binary
# is static). Modules come from proxy.golang.org, pinned by upstream's go.sum.
include /usr/share/dpkg/pkg-info.mk

export PATH := /usr/lib/go-1.26/bin:$(PATH)
export GOTOOLCHAIN = local
# Outside the source tree: carapace-generate walks the tree it runs in.
export GOPATH = $(CURDIR)/../.gopath
export GOCACHE = $(CURDIR)/../.gocache
export GOFLAGS = -mod=readonly -modcacherw -trimpath
export CGO_ENABLED = 0

%:
	dh $@

override_dh_auto_configure:
	go mod download

override_dh_auto_build:
	cd cmd/carapace && go generate ./...
	go build -tags release -ldflags "-s -w -X main.version=$(DEB_VERSION_UPSTREAM)" \
	  -o carapace ./cmd/carapace

override_dh_auto_test:

override_dh_auto_install:
	install -Dm755 carapace -t debian/carapace/usr/bin

override_dh_auto_clean:
	rm -rf carapace ../.gopath ../.gocache

override_dh_dwz:
override_dh_strip:
