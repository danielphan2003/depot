# Maintainer: depot <https://github.com/danielphan2003/depot>
# Reviewed from the AUR PKGBUILD `ente-cli` (aur.git commit 4c2cb5b, audited
# 2026-11-03); see ../AUDIT.md. Ente's monorepo tag tarball; only the
# rust/apps/cli crate is built, against Arch's sqlcipher and openssl rather
# than the vendored copies. Changes: no workspace-wide cargo fetch (the
# workspace also holds the Tauri and mobile bindings); `cargo build --locked`
# downloads only the CLI's dependencies, pinned by upstream's Cargo.lock.
pkgname=ente-cli
pkgver=0.4.3
pkgrel=1
pkgdesc='Command-line client for Ente Photos and Auth: export, sync and account tools'
arch=('x86_64')
url='https://github.com/ente/ente'
license=('AGPL-3.0-only')
depends=('dbus' 'gcc-libs' 'glibc' 'openssl' 'sqlcipher')
makedepends=('cargo' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/ente-cli-v$pkgver.tar.gz")
sha256sums=('673068ca895287bf21040f0d4b1ed6653d0b451de94cf508a8412a6326cdedcc')

build() {
  cd "ente-ente-cli-v$pkgver/rust"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  export LIBSQLITE3_SYS_USE_PKG_CONFIG=1 OPENSSL_NO_VENDOR=1
  CFLAGS+=' -ffat-lto-objects'
  cargo build --locked --release -p ente-cli --bin ente
}

package() {
  cd "ente-ente-cli-v$pkgver"
  install -Dm755 rust/target/release/ente -t "$pkgdir/usr/bin"
  install -Dm644 rust/apps/cli/README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
