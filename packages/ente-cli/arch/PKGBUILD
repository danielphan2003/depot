# Maintainer: depot <https://github.com/danielphan2003/depot>
# Upstream's static release binary, repackaged; nothing is compiled. lint.sh
# checks GitHub's release attestation for the pinned file; see ../AUDIT.md.
pkgname=ente-cli
pkgver=0.4.3
pkgrel=1
pkgdesc='Command-line client for Ente Photos and Auth: export, sync and account tools'
arch=('x86_64')
url='https://github.com/ente/ente'
license=('AGPL-3.0-only')
options=('!strip' '!debug')
source=("$url/releases/download/ente-cli-v$pkgver/ente-cli-v$pkgver-linux-amd64.tar.gz")
sha256sums=('abc9c387ed01f657b1316ac6852073475b7bab0ea4878cd5200b8986ed539b63')

package() {
  install -Dm755 ente -t "$pkgdir/usr/bin"
}
