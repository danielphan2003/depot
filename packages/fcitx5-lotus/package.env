# The upstream release every recipe of this package builds. arch/PKGBUILD
# repeats version and sha256 as literals; scripts/lint.sh checks they agree
# and that the binary carries the attestation named below. This is
# upstream's own release binary, not a source tarball (AUDIT.md).
version=6.0.4
source_url=https://github.com/LotusInputMethod/fcitx5-lotus/releases/download/v6.0.4/fcitx5-lotus-v6.0.4-x86_64-archlinux.tar.zst
sha256=23c04d0a366346057fab5cc59d77b255b37319d209032c2d306d24f4368a9c52
source_strip=0
attest=build:.github/workflows/build-and-release.yml
upstream=https://github.com/LotusInputMethod/fcitx5-lotus
