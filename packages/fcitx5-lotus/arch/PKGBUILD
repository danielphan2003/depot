# Maintainer: depot <https://github.com/danielphan2003/depot>
# Upstream's Arch release build, repackaged; nothing is compiled. lint.sh
# checks its SLSA build provenance (upstream's build-and-release workflow, at
# the release tag) for the pinned file; see ../AUDIT.md. Only usr/ is
# packaged: the tarball's etc/ (runit and OpenRC services) stays out, as it
# did in the source build, and so does an install script.
#
# The package installs root-level integration that depot normally refuses;
# ../allow lists each path (Daniel approved, 2026-11-03).
pkgname=fcitx5-lotus
pkgver=6.0.7
pkgrel=1
pkgdesc='Vietnamese input method for fcitx5'
arch=('x86_64')
url='https://github.com/LotusInputMethod/fcitx5-lotus'
license=('GPL-3.0-or-later')
depends=('acl' 'dbus' 'fcitx5' 'fcitx5-configtool' 'fcitx5-gtk' 'fcitx5-qt'
  'gcc-libs' 'glibc' 'hicolor-icon-theme' 'libevdev' 'libinput' 'libnotify'
  'libudev.so' 'python' 'python-dbus' 'python-pyqt6' 'python-qtpy')
options=('!strip' '!debug')
source=("$url/releases/download/v$pkgver/fcitx5-lotus-v$pkgver-x86_64-archlinux.tar.zst")
sha256sums=('b4c249038c94d301a293e8ee383be8664d44e199593c1e64b35b552da9b2a2a4')

package() {
  # The modes come from upstream; the owner is root's, whoever extracted it.
  cp -r --preserve=mode --no-preserve=ownership usr "$pkgdir/"
}
