# The upstream release every recipe of this package builds. The debian and rpm
# builds read this file. scripts/lint.sh checks that all copies agree, and
# scripts/bump.sh updates them.
version=0.16.0
# gitea.com refuses archive downloads from some GitHub runner addresses (403),
# so the source is the Go module proxy's copy of the tag, which the Go
# checksum database also records (AUDIT.md). The zip nests the tree under
# gitea.dev/tea@v<version>/.
source_url=https://proxy.golang.org/gitea.dev/tea/@v/v0.16.0.zip
sha256=148e88a80b8bf918d10596cd7d7577e88d67de7b1bea6beec5a113a208f58332
source_strip=2
upstream=https://gitea.com/gitea/tea
