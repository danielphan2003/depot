# Maintainer: depot <https://github.com/danielphan2003/depot>
# Written for depot from upstream's tag tarball and Cargo.lock; see
# ../AUDIT.md. Named railway-cli because Arch's extra repository already has
# an unrelated `railway` (a GNOME train-journey app).
pkgname=railway-cli
pkgver=5.71.0
pkgrel=1
pkgdesc='Railway command-line client'
arch=('x86_64')
url='https://github.com/railwayapp/cli'
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('953b79a2d4422344a64ef2929487a66ebc3e1f67b4024116a55c8da8eebffba3')

prepare() {
  cd "cli-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target host-tuple
}

build() {
  cd "cli-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  CFLAGS+=' -ffat-lto-objects'
  cargo build --frozen --release
}

package() {
  cd "cli-$pkgver"
  install -Dm755 target/release/railway -t "$pkgdir/usr/bin"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
