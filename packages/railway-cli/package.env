# The upstream release every recipe of this package builds. The rpm build reads
# this file; arch/PKGBUILD repeats version and sha256 as literals.
# scripts/lint.sh checks that all copies agree and that the binary carries the
# attestation named below, and scripts/bump.sh updates them. This is
# upstream's own static release binary, not a source tarball (AUDIT.md).
version=5.74.0
source_url=https://github.com/railwayapp/cli/releases/download/v5.74.0/railway-v5.74.0-x86_64-unknown-linux-musl.tar.gz
sha256=0fc8d11c416b666d4963e9727581b62ad136f5bd83df79dbd85d66f9e4b845f7
source_strip=0
attest=release
upstream=https://github.com/railwayapp/cli
