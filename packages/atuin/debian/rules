#!/usr/bin/make -f
# As ../rpm/atuin.spec: upstream's release binary, installed as it is.
# Nothing is compiled, and the binary is not stripped.
%:
	dh $@

override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:

override_dh_auto_install:
	install -Dm755 atuin -t debian/atuin/usr/bin

override_dh_auto_clean:
override_dh_dwz:
override_dh_strip:
